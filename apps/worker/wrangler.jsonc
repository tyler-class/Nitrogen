{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nitrogen",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/auth/*", "/oauth/*", "/hooks/*", "/admin/*", "/.well-known/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "nitrogen", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "vars": {
    "GITHUB_OWNER": "",
    "GITHUB_REPO": "",
    "DEFAULT_BRANCH": "main",
    "ALLOWED_GITHUB_IDS": "",
    "GITHUB_API": "https://api.github.com"
  },
  "observability": { "enabled": true }
}
