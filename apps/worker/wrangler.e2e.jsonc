{
  "name": "nitrogen-e2e",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/auth/*", "/oauth/*", "/authorize", "/token", "/register", "/hooks/*", "/admin/*", "/.well-known/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "nitrogen-e2e", "database_id": "e2e", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "e2e" }],
  "vars": {
    "GITHUB_OWNER": "octo",
    "GITHUB_REPO": "notes",
    "DEFAULT_BRANCH": "main",
    "ALLOWED_GITHUB_IDS": "1001",
    "GITHUB_API": "http://127.0.0.1:9999",
    "GITHUB_WEB": "http://127.0.0.1:9999",
    "GITHUB_TEST_TOKEN": "ghs_e2e_token",
    "SESSION_SECRET": "e2e-session-secret-0123456789",
    "INGEST_HMAC_SECRET": "e2e-ingest",
    "GITHUB_WEBHOOK_SECRET": "e2e-webhook",
    "GITHUB_OAUTH_CLIENT_ID": "Iv1.e2e",
    "GITHUB_OAUTH_CLIENT_SECRET": "e2e",
    "COOKIE_ENCRYPTION_KEY": "e2e-cookie"
  }
}
