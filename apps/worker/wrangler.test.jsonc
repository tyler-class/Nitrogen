{
  "name": "nitrogen-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "nitrogen-test", "database_id": "test", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "test" }],
  "vars": {
    "GITHUB_OWNER": "octo",
    "GITHUB_REPO": "notes",
    "DEFAULT_BRANCH": "main",
    "ALLOWED_GITHUB_IDS": "1001",
    "GITHUB_API": "https://api.github.com"
  }
}
