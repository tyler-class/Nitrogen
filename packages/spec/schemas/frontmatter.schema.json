{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nitrogen.dev/schemas/frontmatter.schema.json",
  "title": "CFM page frontmatter (strict flat subset)",
  "type": "object",
  "additionalProperties": { "type": ["string", "number", "boolean", "null", "array"] },
  "properties": {
    "title": { "type": "string" },
    "icon": { "type": "string" },
    "order": { "type": "integer" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "pinned": { "type": "boolean" },
    "locked": { "type": "boolean" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
