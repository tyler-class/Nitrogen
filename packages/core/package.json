{
  "name": "@nitrogen/core",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Nitrogen format engine: parse, lint, autofix, index, normalize CFM markdown",
  "exports": {
    ".": "./src/index.ts",
    "./light": "./src/light/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./light": {
        "types": "./dist/light/index.d.ts",
        "import": "./dist/light/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "mdast-util-directive": "^3.2.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "unist-util-visit": "^5.0.0",
    "unist-util-visit-parents": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@nitrogen/spec": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3"
  },
  "sideEffects": false
}
